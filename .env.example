# Copie para `.env` (gitignored). `scripts/gerar-ambiente.mjs` transforma estas
# variaveis em `src/environments/ambiente.local.ts` no postinstall/prestart/prebuild/
# pretest. O arquivo gerado e gitignored, entao nenhuma chave real entra no git.
#
# O projeto Supabase e unico e compartilhado por todos os apps do roadmap (§4):
# https://jlvqrfewiuqhduvbufqe.supabase.co
#
# Vazio = modo demo: o app sobe sem backend e mostra o aviso na tela.

# --- Supabase (projeto compartilhado do roadmap) ---
VITE_SUPABASE_URL=https://jlvqrfewiuqhduvbufqe.supabase.co
# Anon key (publishable). Segura para o front porque o RLS e quem protege.
# A service_role key NUNCA vai aqui nem no repo.
VITE_SUPABASE_ANON_KEY=
# Identifica este app nas tabelas `leads` / `products` (§4.2).
VITE_SUPABASE_PROJECT_SLUG=ledger
# `demo` restringe o seed e habilita o mock local (§4.5).
VITE_ROLE=demo

# --- Microsoft Clarity (mapa de calor) ---
# Criar projeto em https://clarity.microsoft.com/projects/new e colar o ID
# (o numero que vai em clarity.ms/tag/XXXXXXXXXXXXXXXX)
CLARITY_PROJECT_ID=

# --- Bot humano / uptime (preencher quando subir producao/homologacao) ---
BOT_URL=
